# Python runtime environment only — project code and data are bind-mounted
# at runtime (see slurm/train.sh). Mirrors docker/Dockerfile, but built for
# the standalone machine with an NVIDIA RTX PRO 6000 Blackwell (CC 12.0 /
# sm_120) GPU.
#
# The main Dockerfile is pinned to CUDA 12.6 for the primary HPC cluster
# (driver maxes out at CUDA 12.6), but torch==2.13.0+cu126 ships no sm_120
# kernels, so it fails on this GPU with "no kernel image is available for
# execution on the device". This machine's driver reports
# "CUDA UMD Version: 13.3" (see `nvidia-smi`), so CUDA 13.0 is safe here
# (CUDA is backward- but not forward-compatible with the driver).
#
# Uses a CUDA devel base (not just python:slim) because deepspeed's
# op_builder calls installed_cuda_version() at `import deepspeed` time,
# which requires nvcc/CUDA_HOME to exist even when no custom op is built.
FROM nvidia/cuda:13.0.1-devel-ubuntu22.04

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV DEBIAN_FRONTEND=noninteractive

# Ubuntu 22.04's default python3 is already 3.10.12, matching the .venv.
# python3.10-dev provides Python.h, needed by deepspeed's op builder to
# JIT-compile its C++ extensions at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3-pip \
    build-essential \
    libaio-dev \
    && rm -rf /var/lib/apt/lists/*

# torch/torchvision come from PyTorch's cu130 index explicitly, which is
# the first cu13x build with sm_120 (Blackwell) kernels.
RUN python3.10 -m pip install --no-cache-dir --upgrade pip && \
    python3.10 -m pip install --no-cache-dir \
      torch==2.13.0+cu130 torchvision==0.28.0+cu130 \
      --index-url https://download.pytorch.org/whl/cu130

COPY requirements-lock.txt /tmp/requirements-lock.txt
RUN python3.10 -m pip install --no-cache-dir -r /tmp/requirements-lock.txt && \
    rm /tmp/requirements-lock.txt

WORKDIR /workspace
